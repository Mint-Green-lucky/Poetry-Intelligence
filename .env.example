# Copy this file to .env and fill in your private credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=qwen-plus
MAX_CCPC_IN_MEMORY=30000
EVOLVE_THRESHOLD=50
VECTOR_RAG_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
MAX_HISTORY=8
LIVE_ENABLED=true
LIVE_API_KEY=
LIVE_REALTIME_URL=
LIVE_MODEL=qwen-omni-turbo-realtime
LIVE_VOICE=Ethan
EVOLUTION_MIN_DELTA=0.02
EVOLUTION_ROLLBACK_WINDOW=10
# 默认关闭，且需要同时在项目根目录提供 mcp_servers.json 才会真正连接外部 Server
MCP_ENABLED=false
MCP_CALL_TIMEOUT=15
